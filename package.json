{
  "name": "soroban-indexer-ts",
  "version": "0.1.0",
  "description": "TypeScript indexer for Soroban smart contract events on Stellar. Polls the RPC, parses events, and stores them in a queryable database.",
  "private": true,
  "files": ["dist", "scripts", "README.md", "CURSORWITNESS_ADAPTER.md", ".env.example"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src --ext .ts",
    "package:check": "pnpm run build && node scripts/verify-package.mjs",
    "cursorwitness:check": "pnpm run build && node scripts/verify-cursorwitness.mjs"
  },
  "dependencies": {
    "@cursorwitness/core": "git+https://github.com/CursorWitness/cursorwitness-core.git#fba74b3",
    "@stellar/stellar-sdk": "^13.1.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
